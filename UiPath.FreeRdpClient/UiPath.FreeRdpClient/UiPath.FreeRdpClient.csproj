<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net6.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<Authors>UiPath</Authors>
		<Description>FreeRdp client for c#</Description>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<IsPackable>true</IsPackable>
		<PackageOutputPath>$(CppOutDir)</PackageOutputPath>
		<VersionPrefix>22.9.0</VersionPrefix>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="6.0.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="6.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="6.0.0" />
		<PackageReference Include="Nito.AsyncEx" Version="5.1.2" />
	</ItemGroup>
	<ItemGroup>
		<None Include="$(CppOutDir)\$(Configuration)\**\UiPath.FreeRdpWrapper.dll"
			  Pack="True" PackagePath="runtimes\win-%(RecursiveDir)native\%(Filename)%(Extension)" >
			<Link>runtimes\win-%(RecursiveDir)native\%(Filename)%(Extension)</Link>
		</None>
		<None Include="$(CppOutDir)\$(Configuration)\**\UiPath.FreeRdpWrapper.pdb"
			  Pack="True" PackagePath="runtimes\win-%(RecursiveDir)native\%(Filename)%(Extension)">
			<Link>runtimes\win-%(RecursiveDir)native\%(Filename)%(Extension)</Link>
		</None>
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\BuildCpp.msbuildproj">
		  <ReferenceOutputAssembly>False</ReferenceOutputAssembly>
		</ProjectReference>
	</ItemGroup>
</Project>
