<Project Sdk="Microsoft.Build.NoTargets">
	<Target Name="BuildAllCpp" BeforeTargets="Build">
		<MSBuild Projects="UiPath.FreeRdpWrapper\UiPath.FreeRdpWrapper.vcxproj"
				 Properties="Configuration=$(Configuration);Platform=Win32" RebaseOutputs="true" />
		<MSBuild Projects="UiPath.FreeRdpWrapper\UiPath.FreeRdpWrapper.vcxproj"
				 Properties="Configuration=$(Configuration);Platform=x64" RebaseOutputs="true" />
	</Target>
	<Target Name="CleanAllCpp" BeforeTargets="Clean">
		<MSBuild Projects="UiPath.FreeRdpWrapper\UiPath.FreeRdpWrapper.vcxproj"
				 Properties="Configuration=$(Configuration);Platform=Win32" Targets="Clean" />
		<MSBuild Projects="UiPath.FreeRdpWrapper\UiPath.FreeRdpWrapper.vcxproj"
				 Properties="Configuration=$(Configuration);Platform=x64" Targets="Clean" />
	</Target>
	<ItemGroup>
		<ProjectReference Include="UiPath.FreeRdpWrapper\UiPath.FreeRdpWrapper.vcxproj" />
	</ItemGroup>
</Project>